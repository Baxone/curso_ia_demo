# Variables de entorno — VALORES FICTICIOS para documentación
# Copia este fichero a .env y rellena con valores reales (nunca commitees .env)

# Base de datos
DB_HOST=localhost
DB_PORT=5432
DB_NAME=transactions_db
DB_USER=app_user
DB_PASSWORD=CAMBIAR_POR_PASSWORD_REAL

# API Keys
API_KEY=CAMBIAR_POR_API_KEY_REAL
EXTERNAL_SERVICE_URL=https://api.ejemplo.com

# Auth
JWT_SECRET=CAMBIAR_POR_SECRET_REAL_MIN_32_CHARS
JWT_EXPIRY=24h

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Límites
MAX_FILE_SIZE_MB=10
MAX_CSV_ROWS=50000
